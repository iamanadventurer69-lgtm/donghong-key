<view class="mission-page">
  <view class="mission-top">
    <text class="eyebrow">{{mission.code}} / 探索任务</text>
    <button bindtap="back">返回地图</button>
  </view>
  <view class="scene" style="background:linear-gradient(145deg, {{mission.color}}, #e9f8ff)">
    <view class="scene-grid"/>
    <view class="scene-building">
      <view class="building-window"/>
      <view class="building-window"/>
      <view class="building-window"/>
      <view class="building-window"/>
    </view>
    <view class="scene-title">{{mission.title}}</view>
    <view class="scene-direction">{{mission.direction}}</view>
    <view class="npc"><view class="npc-head">{{mission.npc.avatar}}</view><text>{{mission.npc.name}}</text></view>
  </view>
  <view class="dialog" wx:if="{{phase==='talk'}}">
    <view class="dialog-role">{{mission.npc.name}} · {{mission.npc.role}}</view>
    <view class="dialog-text">{{mission.lines[dialogIndex]}}</view>
    <button class="primary" bindtap="next">{{dialogIndex+1 < mission.lines.length?'继续对话':'接受任务'}}</button>
  </view>
  <view class="dialog quiz" wx:elif="{{phase==='quiz'}}">
    <view class="eyebrow">任务判断</view>
    <view class="question">{{mission.question}}</view>
    <button wx:for="{{mission.options}}" wx:key="id" class="answer" data-id="{{item.id}}" bindtap="answer">{{item.text}}</button>
    <view class="feedback" wx:if="{{feedback}}">{{feedback}}</view>
  </view>
  <view class="dialog complete" wx:else>
    <view class="badge">✓</view>
    <view class="question">{{mission.title}}已点亮</view>
    <view class="feedback">{{mission.success}}</view>
    <view class="culture"><text>本次文化印记</text><strong>{{mission.value}}</strong></view>
    <button class="primary" bindtap="back">返回探索地图</button>
  </view>
</view>
