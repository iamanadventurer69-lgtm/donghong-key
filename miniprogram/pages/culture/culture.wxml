<view class="viewport" bindtouchstart="swipeStart" bindtouchend="swipeEnd" bindtouchcancel="swipeCancel">
  <view class="topline"><text class="eyebrow">SHIFT REPORT / 值班结算</text></view>
  <view wx:if="{{warning}}" class="save-warning">{{warning}}</view>
  <view class="panel" wx:if="{{panel===0}}">
    <view class="seal"><view class="seal-core">{{portrait.trust}}</view></view>
    <view class="title center">{{portrait.level.label}}</view>
    <view class="subtitle center">{{portrait.level.comment}}</view>
    <view class="card">
      <view class="row"><text class="label">客户信任</text><text class="trust-num">{{portrait.trust}} / 100</text></view>
      <view class="progress-track"><view class="progress-fill" style="width:{{portrait.trust}}%"/></view>
      <view class="small muted">信任值由你今天每一次盖章累积而成，不会被人工修正。</view>
    </view>
    <button class="primary" bindtap="nextPanel">看我的文化画像 →</button>
  </view>
  <view class="panel" wx:elif="{{panel===1}}">
    <view class="title">你的文化画像</view>
    <view class="card">
      <view class="label">印记构成</view>
      <view class="mark-row" wx:for="{{portrait.ranked}}" wx:key="name">
        <text class="mark-name">{{item.name}}</text>
        <view class="mark-track">
          <view class="mark-fill {{item.negative?'bad':''}}" style="width:{{item.width}}%"/>
        </view>
        <text class="mark-val {{item.negative?'bad':''}}">{{item.value>0?'+':''}}{{item.value}}</text>
      </view>
    </view>
    <view class="culture">
      <view class="label">最高印记 · {{portrait.top||'尚无'}}</view>
      <view class="quote">{{portrait.style.title}}</view>
    </view>
    <view class="muted small">{{portrait.style.comment}}</view>
    <view class="card highlights">
      <view class="label">你的关键行为</view>
      <view class="highlight" wx:for="{{portrait.highlights}}" wx:key="card">
        <text class="highlight-title">{{item.card}}</text>
        <text class="highlight-choice">{{item.choice}}</text>
      </view>
    </view>
    <button class="primary" bindtap="nextPanel">选择我的行动承诺 →</button>
  </view>
  <view class="panel" wx:else>
    <view class="title">把文化带回工作</view>
    <view class="subtitle">选一项行动，保存你的文化画像。</view>
    <view>
      <button
        wx:for="{{actions}}"
        wx:key="*this"
        class="option {{selected===item?'selected':''}}"
        data-value="{{item}}"
        bindtap="choose"
      >{{selected===item?'◉':'○'}} {{item}}</button>
    </view>
    <view class="small success" wx:if="{{s.completed}}">✓ 全部完成：序章、质量值班、文化画像已记录。</view>
    <button class="primary" disabled="{{!selected}}" bindtap="save">{{s.completed?'更新行动承诺':'保存承诺，完成探索'}}</button>
    <view class="row">
      <button class="text-button" bindtap="progress">探索档案</button>
      <button class="text-button" bindtap="home">返回首页</button>
    </view>
  </view>
  <view class="pager">
    <button class="nav-arrow" bindtap="prevPanel" disabled="{{panel===0}}">‹</button>
    <view class="pager-center">
      <view class="dots"><text wx:for="{{panelCount}}" wx:key="*this" class="dot {{index===panel?'active':''}}"/></view>
      <text>左右滑动翻页 · {{panel+1}} / {{panelCount}}</text>
    </view>
    <button class="nav-arrow" bindtap="nextPanel" disabled="{{panel===panelCount-1}}">›</button>
  </view>
</view>
