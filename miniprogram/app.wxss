page {
  height: 100%;
  overflow: hidden;
  background: #f4fbff;
  color: #173f60;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  font-size: 14px;
  line-height: 1.5;
}
view,
text,
button {
  box-sizing: border-box;
}
button {
  font: inherit;
  margin: 0;
  padding: 0;
  border-radius: 14px;
}
button::after {
  border: 0;
}
button[disabled] {
  background: #e3f0f8 !important;
  color: #7796ac !important;
}
.viewport {
  height: 100vh;
  width: 100%;
  max-width: 600px;
  margin: 0 auto;
  padding: 10px 18px calc(6px + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 8px;
  overflow: hidden;
  background: linear-gradient(155deg, #fff 0%, #f4fbff 50%, #dff3ff 100%);
}
.topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 28px;
  flex-shrink: 0;
}
.eyebrow {
  font-size: 10px;
  letter-spacing: 1.4px;
  color: #357ba7;
  font-weight: 600;
}
.pill {
  border: 1px solid #b0def7;
  color: #247cab;
  border-radius: 20px;
  padding: 3px 10px;
  font-size: 11px;
  background: #fff;
}
.panel {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  gap: 10px;
  animation: panel-in 0.25s ease-out;
}
.title {
  font-size: 27px;
  line-height: 1.3;
  font-weight: 650;
  margin: 0;
  color: #163f63;
  flex-shrink: 0;
}
.quote {
  font-size: 17px;
  font-weight: 600;
  line-height: 1.5;
}
.label {
  font-size: 11px;
  color: #247cac;
  letter-spacing: 1px;
  margin-bottom: 4px;
}
.subtitle,
.muted {
  color: #56798f;
}
.subtitle {
  font-size: 14px;
}
.small {
  font-size: 12px;
  line-height: 1.5;
}
.center {
  text-align: center;
}
.card {
  padding: 16px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 18px;
  box-shadow: 0 6px 22px #77bfe612;
}
.culture {
  border-left: 3px solid #39b5f0;
  background: #e2f4ff;
  padding: 10px 14px;
  border-radius: 0 14px 14px 0;
  flex-shrink: 0;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.line {
  height: 1px;
  background: #d9eaf5;
  margin: 12px 0;
}
.primary,
.secondary {
  width: 100%;
  min-height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 10px 12px;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.45;
}
.primary {
  background: #249fdc;
  color: #fff;
  box-shadow: 0 5px 16px #159bd025;
}
.secondary {
  background: #fff;
  border: 1px solid #9dd5f5;
  color: #226b99;
}
.text-button {
  background: transparent;
  color: #4380a3;
  font-size: 12px;
  padding: 6px 10px;
}
.tag {
  display: inline-block;
  align-self: flex-start;
  padding: 4px 9px;
  border-radius: 7px;
  background: #e1f3ff;
  color: #1478ad;
  font-size: 12px;
}
.number {
  font:
    30px Menlo,
    monospace;
  color: #269dd7;
}
.progress-track {
  height: 5px;
  background: #e2f0f8;
  border-radius: 5px;
  overflow: hidden;
  margin: 12px 0;
}
.progress-fill {
  height: 100%;
  background: #37b6ee;
  transition: width 0.4s;
}
.values {
  display: flex;
  justify-content: space-around;
  color: #237fb1;
  font-size: 18px;
  letter-spacing: 2px;
}
.chapter-card {
  display: flex;
  align-items: center;
  gap: 16px;
}
.section-title {
  font-size: 19px;
  font-weight: 600;
}
.chapter-card .tag {
  margin-left: auto;
}
.hero-title {
  font-size: 46px;
  font-weight: 700;
  line-height: 1.25;
  color: #174b72;
}
.hero-title text {
  color: #39b9f2;
}
.hero-sub {
  font-size: 22px;
  letter-spacing: 6px;
  color: #258fc8;
  margin-top: 4px;
}
.network-space {
  flex: 1;
  min-height: 95px;
  max-height: 260px;
}
.hero-title,
.hero-sub {
  flex-shrink: 0;
}
.narration {
  font-size: 14px;
  line-height: 1.75;
}
.scene-title {
  white-space: pre-line;
  font-size: 25px;
}
.pager {
  height: 48px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid #cce5f4;
  gap: 12px;
}
.nav-arrow {
  background: #fff;
  color: #278ec4;
  width: 44px;
  height: 40px;
  line-height: 36px;
  font-size: 29px;
  border: 1px solid #c2e3f6;
}
.pager-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  font-size: 10px;
  color: #4f7e9c;
}
.dots {
  display: flex;
  gap: 7px;
}
.dot {
  width: 5px;
  height: 5px;
  border-radius: 5px;
  background: #bedbeb;
}
.dot.active {
  width: 19px;
  background: #29a8e5;
}
.save-warning {
  background: #fff0df;
  color: #7e5421;
  font-size: 11px;
  padding: 6px 10px;
  border-radius: 8px;
  flex-shrink: 0;
}
.option {
  display: block;
  text-align: left;
  width: 100%;
  padding: 12px;
  background: #fff;
  color: #214f6e;
  border: 1px solid #bfdef2;
  border-radius: 12px;
  margin: 8px 0;
  line-height: 1.5;
  font-size: 14px;
}
.option.selected {
  border-color: #2eace4;
  background: #dff3ff;
}
.stage {
  display: flex;
  gap: 10px;
  padding: 7px 0;
  font-size: 13px;
}
.stage .muted {
  margin-left: auto;
}
.success {
  color: #1485bb;
}
.direction {
  margin-top: 12px;
}
.seal {
  display: flex;
  justify-content: center;
  padding: 12px;
}
.seal-core {
  width: 120px;
  height: 120px;
  border: 2px solid #45b9ee;
  outline: 1px solid #c0e6fb;
  outline-offset: 8px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52px;
  color: #238fc7;
  background: radial-gradient(circle, #fff, #d9f1ff);
  animation: core-light 1.2s ease-out;
}
.chapter-culture {
  padding: 7px 12px;
}
.chapter-culture .quote {
  font-size: 16px;
}
.chapter-culture .label {
  margin: 0;
  font-size: 10px;
}
.chapter-panel {
  gap: 8px;
}
.chapter-panel .title {
  font-size: 24px;
}
.feedback-space {
  min-height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.feedback {
  font-size: 12px;
  line-height: 1.4;
  color: #276c92;
  background: #e0f2ff;
  border-radius: 10px;
  padding: 8px 10px;
  width: 100%;
}
.meter-hero {
  align-self: center;
  width: 230px;
  border: 1px solid #a5d6ef;
  background: #fff;
  border-radius: 18px;
  padding: 16px;
  color: #4281a4;
  transform: rotate(-4deg);
  animation: meter-arrive 0.75s ease-out;
  font-size: 11px;
  box-shadow: 0 12px 30px #75b2da26;
}
.meter-screen {
  background: #e5f5ff;
  border: 4px solid #cbe4f3;
  padding: 12px;
  margin: 12px 0;
  border-radius: 8px;
}
.meter-digits {
  font:
    28px Menlo,
    monospace;
  letter-spacing: 2px;
  color: #268bc4;
}
.module-grid,
.slot-grid,
.tray {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.module {
  width: 100%;
  text-align: left;
  padding: 12px;
  background: #fff;
  color: #204f70;
  border: 1px solid #b8def4;
  font-size: 15px;
  line-height: 1.5;
}
.module.seen {
  border-color: #34abe1;
  background: #e6f6ff;
}
.module-code {
  font:
    11px Menlo,
    monospace;
  color: #2e95ca;
  margin-bottom: 5px;
}
.module-detail {
  padding: 10px 12px;
  background: #fff;
  border-radius: 12px;
  min-height: 75px;
}
.assembly-zone {
  display: flex;
  flex-direction: column;
  gap: 15px;
}
.slot {
  border: 1.5px dashed #80bfdf;
  background: #eef9ff;
  border-radius: 12px;
  padding: 12px;
  min-height: 66px;
  text-align: center;
}
.slot.filled {
  background: #d4f0ff;
  border: 1.5px solid #249ed7;
  color: #186d9a;
  animation: module-seat 0.55s ease-out;
}
.part {
  background: #fff;
  border: 1px solid #90cce9;
  padding: 10px 6px;
  color: #24668c;
  min-height: 44px;
  font-size: 13px;
}
.part.placed {
  opacity: 0.65;
}
.part.selected {
  background: #ceecff;
  border-color: #238dca;
}
.slot.fault {
  animation: fault-shake 0.18s ease-in-out 3;
  border-color: #d9915c;
  background: #fff1e7;
}
.drag-ghost {
  position: fixed;
  z-index: 99;
  width: 124px;
  height: 56px;
  background: #55bbee;
  color: #fff;
  box-shadow: 0 8px 28px #2889b844;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.instrument-space {
  flex: 1;
  min-height: 170px;
  max-height: 300px;
}
.test-header,
.test-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.test-header {
  font-size: 10px;
  color: #698aa0;
  padding: 6px;
}
.test-row {
  width: 100%;
  background: #fff;
  border: 1px solid #b6daef;
  color: #225474;
  padding: 13px 8px;
  margin: 8px 0;
  font-size: 12px;
}
.test-row.abnormal {
  border-color: #279fd4;
  background: #dbf1ff;
}
.result-row {
  padding: 10px 0;
}
.retest {
  animation: module-seat 0.6s ease-out;
}
@keyframes panel-in {
  from {
    opacity: 0.45;
    transform: translateX(12px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}
@keyframes module-seat {
  0% {
    transform: scale(0.9);
  }
  55% {
    transform: scale(1.04);
    box-shadow: 0 0 20px #65bdec55;
  }
  100% {
    transform: scale(1);
  }
}
@keyframes fault-shake {
  0%,
  100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-4px);
  }
  75% {
    transform: translateX(4px);
  }
}
@keyframes meter-arrive {
  from {
    opacity: 0;
    transform: translateY(18px) rotate(-7deg);
  }
  to {
    opacity: 1;
    transform: translateY(0) rotate(-4deg);
  }
}
@keyframes core-light {
  0% {
    opacity: 0;
    transform: scale(0.65);
  }
  65% {
    opacity: 1;
    transform: scale(1.08);
    box-shadow: 0 0 50px #60c0f377;
  }
  100% {
    transform: scale(1);
  }
}
@media (max-height: 600px) {
  .viewport {
    padding-top: 6px;
    padding-left: 14px;
    padding-right: 14px;
    gap: 5px;
  }
  .panel {
    gap: 6px;
  }
  .topline {
    min-height: 24px;
  }
  .title,
  .chapter-panel .title {
    font-size: 22px;
  }
  .hero-title {
    font-size: 38px;
  }
  .hero-sub {
    font-size: 19px;
  }
  .card {
    padding: 12px;
  }
  .culture {
    padding: 7px 10px;
  }
  .quote {
    font-size: 15px;
  }
  .narration,
  .subtitle {
    font-size: 12px;
  }
  .small {
    font-size: 11px;
  }
  .primary,
  .secondary {
    min-height: 40px;
    padding: 8px;
    font-size: 13px;
  }
  .option {
    padding: 9px;
    margin: 6px 0;
    font-size: 12px;
  }
  .module {
    padding: 9px;
    font-size: 14px;
  }
  .module-detail {
    min-height: 60px;
    padding: 8px;
  }
  .feedback-space {
    min-height: 34px;
  }
  .feedback {
    font-size: 11px;
    padding: 6px 8px;
  }
  .meter-hero {
    width: 185px;
    padding: 10px;
  }
  .meter-screen {
    margin: 8px 0;
    padding: 8px;
  }
  .stage {
    padding: 5px 0;
  }
  .pager {
    height: 44px;
  }
  .seal-core {
    width: 90px;
    height: 90px;
    font-size: 42px;
  }
  .slot {
    padding: 8px;
    min-height: 55px;
  }
  .assembly-zone {
    gap: 10px;
  }
  .slot-grid,
  .tray,
  .module-grid {
    gap: 8px;
  }
  .part {
    min-height: 40px;
    padding: 8px;
  }
  .instrument-space {
    min-height: 155px;
  }
  .direction {
    margin-top: 9px;
  }
}
@media (max-height: 520px) {
  .viewport {
    gap: 4px;
    padding-top: 4px;
    padding-bottom: calc(4px + env(safe-area-inset-bottom));
  }
  .panel {
    gap: 5px;
  }
  .chapter-culture .label {
    display: none;
  }
  .chapter-culture {
    padding: 5px 10px;
  }
  .chapter-panel .module .small {
    display: none;
  }
  .module {
    padding: 8px;
  }
  .module-detail {
    min-height: 48px;
  }
  .feedback-space {
    min-height: 28px;
  }
  .feedback {
    padding: 5px 7px;
    font-size: 10px;
  }
  .card {
    padding: 9px;
  }
  .line {
    margin: 8px 0;
  }
  .stage {
    padding: 4px 0;
  }
  .title,
  .chapter-panel .title {
    font-size: 20px;
  }
  .instrument-space {
    min-height: 150px;
  }
  .meter-hero {
    width: 160px;
  }
  .meter-screen {
    padding: 5px;
    margin: 5px 0;
  }
  .meter-digits {
    font-size: 24px;
  }
  .hero-title {
    font-size: 34px;
  }
  .network-space {
    min-height: 70px;
  }
  .quote {
    font-size: 14px;
  }
  .seal-core {
    width: 72px;
    height: 72px;
    font-size: 36px;
  }
  .option {
    font-size: 12px;
    padding: 8px;
    margin: 5px 0;
  }
  .primary,
  .secondary {
    min-height: 38px;
  }
  .pager {
    height: 42px;
  }
  .nav-arrow {
    height: 36px;
    line-height: 32px;
  }
  .slot {
    min-height: 50px;
    padding: 7px;
  }
  .part {
    min-height: 36px;
    padding: 6px;
  }
}
