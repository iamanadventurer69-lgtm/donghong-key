<view class="viewport" bindtouchstart="swipeStart" bindtouchend="swipeEnd" bindtouchcancel="swipeCancel">
  <view class="topline"><text class="eyebrow">PROLOGUE / 一度电的旅程</text></view>
  <view wx:if="{{warning}}" class="save-warning">{{warning}}</view>
  <view class="panel">
    <view><view class="label">{{scene.tag}}</view><view class="title scene-title">{{scene.title}}</view></view>
    <view class="network-space"><energy-network active="{{scene.nodes}}"/></view>
    <view class="narration">{{scene.text}}</view>
    <view class="culture"><view class="label">这是东鸿的使命</view><view class="quote">{{culture.mission}}</view></view>
    <button class="primary" bindtap="next">{{panel===2?'领取使命密钥，进入第一章':'追踪下一段能量 →'}}</button>
  </view>
  <view class="pager">
    <button class="nav-arrow" bindtap="prevPanel" disabled="{{panel===0}}">‹</button>
    <view class="pager-center">
      <view class="dots"><text wx:for="{{panelCount}}" wx:key="*this" class="dot {{index===panel?'active':''}}"/></view>
      <text>左右滑动翻页 · {{panel+1}} / {{panelCount}}</text>
    </view>
    <button class="nav-arrow" bindtap="nextPanel" disabled="{{panel===panelCount-1}}">›</button>
  </view>
</view>
