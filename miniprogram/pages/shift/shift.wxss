/* 值班页：顶部状态、中间一张材料卡、底部盖章动作。整屏不滚动。 */
.topline-actions {
  display: flex;
  align-items: center;
  gap: 4px;
}

.hud {
  flex-shrink: 0;
  padding: 9px 12px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 14px;
}

.trust-num {
  font:
    600 18px Menlo,
    monospace;
  color: #1c7fb4;
}

.trust-track {
  height: 6px;
  background: #e2f0f8;
  border-radius: 6px;
  overflow: hidden;
  margin: 6px 0 8px;
}

.trust-fill {
  height: 100%;
  background: linear-gradient(90deg, #4bc0f0, #249fdb);
  transition: width 0.4s ease;
}

.marks {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.mark {
  font-size: 10px;
  padding: 2px 7px;
  border-radius: 20px;
  background: #eef7fd;
  color: #5a7d92;
}

.mark.good {
  background: #e3f6ff;
  color: #1577a8;
  font-weight: 600;
}

.mark.bad {
  background: #fdeeea;
  color: #b8513c;
  font-weight: 600;
}

.sheet {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 12px 14px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 18px;
  box-shadow: 0 6px 22px #77bfe612;
  animation: sheet-in 0.25s ease-out;
  overflow: hidden;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.sheet-tag {
  font-size: 10px;
  letter-spacing: 0.6px;
  color: #1e7fb0;
  background: #e6f5ff;
  border-radius: 20px;
  padding: 3px 9px;
}

.sheet-index {
  font-size: 10px;
  color: #7d9cb0;
}

.sheet-title {
  font-size: 20px;
  font-weight: 650;
  color: #123f60;
  line-height: 1.3;
  margin-top: 2px;
}

.sheet-from {
  font-size: 11px;
  color: #2e84b0;
}

.sheet-body {
  font-size: 13px;
  line-height: 1.6;
  color: #24556f;
}

.docs {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 5px;
  margin-top: 3px;
}

.doc {
  padding: 6px 9px;
  border-left: 3px solid #7fd0f0;
  background: #f2faff;
  border-radius: 0 8px 8px 0;
}

.doc-label {
  display: block;
  font-size: 10px;
  color: #1d86b8;
  font-weight: 600;
}

.doc-text {
  font-size: 11px;
  color: #3d6a83;
  line-height: 1.5;
}

.stamp {
  align-self: center;
  margin-top: 2px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 7px 20px;
  font-size: 26px;
  font-weight: 800;
  letter-spacing: 5px;
  border: 3px solid;
  border-radius: 12px;
  animation: stamp-in 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.5);
}

.stamp.release {
  color: #1a8f5f;
  border-color: #1a8f5f;
  background: #e9f8f1;
}

.stamp.return {
  color: #c2543f;
  border-color: #c2543f;
  background: #fdeeea;
}

.delta {
  display: flex;
  align-items: baseline;
  gap: 6px;
}

.delta-num {
  font:
    600 16px Menlo,
    monospace;
}

.delta-num.minus {
  color: #c2543f;
}

.delta-num.plus {
  color: #1a8f5f;
}

.mark-delta {
  font-size: 10px;
  color: #6a8ea4;
  background: #f2faff;
  border-radius: 8px;
  padding: 4px 8px;
  align-self: flex-start;
}

.actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.actions .stamp-button {
  width: 100%;
  min-height: 46px;
  /* 按钮有固定高度时必须自己居中，否则文字会贴在顶部 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 2px;
  border-radius: 14px;
}

.stamp-button.release {
  background: #1f9d6b;
  color: #fff;
  box-shadow: 0 5px 16px #1f9d6b33;
}

.stamp-button.back {
  background: #fff;
  color: #b8513c;
  border: 1px solid #e6b7aa;
}

.option {
  width: 100%;
  text-align: left;
  padding: 11px 12px;
  background: #f4faff;
  border: 1px solid #bfdef2;
  border-radius: 12px;
  color: #235b7a;
  font-size: 13px;
  line-height: 1.45;
}

.hint {
  flex-shrink: 0;
  text-align: center;
  font-size: 10px;
  color: #7d9cb0;
}

.rules-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: #0e3a5733;
  display: flex;
  align-items: center;
  padding: 24px;
}

.rules {
  width: 100%;
  background: #fff;
  border-radius: 18px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.rule {
  font-size: 12px;
  line-height: 1.55;
  color: #2b5f7d;
}

@keyframes sheet-in {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes stamp-in {
  from {
    opacity: 0;
    transform: rotate(-18deg) scale(1.9);
  }
  to {
    opacity: 1;
    transform: rotate(-4deg) scale(1);
  }
}

@media (max-height: 700px) {
  .sheet {
    padding: 10px 12px;
    gap: 4px;
  }
  .sheet-title {
    font-size: 18px;
  }
  .sheet-body {
    font-size: 12px;
    line-height: 1.5;
  }
  .doc {
    padding: 5px 8px;
  }
  .doc-text {
    font-size: 10px;
  }
  .actions .option {
    padding: 8px 10px;
    font-size: 12px;
  }
  .actions .stamp-button {
    min-height: 40px;
    font-size: 14px;
  }
  .stamp {
    font-size: 22px;
    padding: 5px 16px;
  }
  .primary {
    min-height: 40px;
  }
}

@media (max-height: 560px) {
  .hud {
    padding: 6px 10px;
  }
  .marks,
  .hint {
    display: none;
  }
  .sheet-title {
    font-size: 17px;
  }
  .rule {
    font-size: 11px;
  }
}
