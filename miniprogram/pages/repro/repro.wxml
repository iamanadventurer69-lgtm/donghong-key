<view class="viewport">
  <view class="topline">
    <text class="eyebrow">{{game.code}} / {{game.title}}</text>
    <button class="text-button" bindtap="back">返回闯关</button>
  </view>
  <view class="npc">
    <view class="npc-head">{{game.npc.avatar}}</view>
    <view class="npc-main">
      <text class="npc-name">{{game.npc.name}} · {{game.npc.role}}</text>
      <text class="npc-text">{{game.brief}}</text>
    </view>
  </view>
  <view class="hud">
    <view class="hud-item"><text class="hud-val">{{load}}%</text><text class="hud-lbl">当前负载</text></view>
    <view class="hud-item"><text class="hud-val">{{powered?'已通电':'已断电'}}</text><text class="hud-lbl">实验台</text></view>
    <view class="hud-item">
      <text class="hud-val">{{hold}}<text class="hud-sub">/{{holdSeconds}} 秒</text></text>
      <text class="hud-lbl">高负载保持</text>
    </view>
  </view>
  <view class="meter"><live-meter calibrated="{{false}}" bind:loadchange="onLoadChange"/></view>
  <view class="feedback {{done?'good':''}}">{{message}}</view>
  <view class="hint">目标：通电后把负载推到 {{targetMin}}% 以上，并保持 {{holdSeconds}} 秒</view>
  <view class="mask" wx:if="{{done}}">
    <view class="sheet">
      <view class="win-title">✅ 偏差复现成功</view>
      <view class="win-text">{{game.success}}</view>
      <view class="win-value">本次文化印记 · {{game.value}}</view>
      <button class="primary" bindtap="finish">回到闯关中心 →</button>
      <button class="secondary" bindtap="back">返回上一页</button>
    </view>
  </view>
</view>
