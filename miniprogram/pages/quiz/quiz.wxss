/* 知识答题：进度点 + 题目卡 + 逐题回顾。 */
.dots {
  flex-shrink: 0;
  display: flex;
  gap: 4px;
}

.dot {
  flex: 1;
  height: 5px;
  border-radius: 3px;
  background: #dbeaf3;
  transition: background 0.3s;
}

.dot.done {
  background: #1f9d6b;
}

.dot.wrong {
  background: #c2543f;
}

.dot.cur {
  background: #249fdb;
}

.card {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 13px 14px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 18px;
}

.q-num {
  font-size: 10px;
  letter-spacing: 1px;
  font-weight: 700;
  color: #1c7fb4;
}

.q-text {
  font-size: 15px;
  font-weight: 650;
  line-height: 1.55;
  color: #123f60;
}

.q-opts {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6px;
}

.option {
  display: flex;
  align-items: center;
  gap: 9px;
  width: 100%;
  text-align: left;
  padding: 9px 11px;
  background: #f4faff;
  border: 1px solid #bfdef2;
  border-radius: 12px;
  color: #235b7a;
  font-size: 12.5px;
  line-height: 1.45;
}

.option.right {
  background: #e8f8f1;
  border-color: #1a8f5f;
  color: #146b48;
}

.option.wrong {
  background: #fdeeea;
  border-color: #c2543f;
  color: #a4452f;
}

.letter {
  flex: none;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #e4f4fe;
  color: #1c7fb4;
  font-size: 11px;
  font-weight: 700;
  text-align: center;
  line-height: 20px;
}

.explain {
  font-size: 11px;
  line-height: 1.6;
  padding: 8px 10px;
  border-radius: 10px;
  border-left: 3px solid;
}

.explain.ok {
  background: #eaf9f2;
  border-color: #1a8f5f;
  color: #206a4c;
}

.explain.no {
  background: #fdeeea;
  border-color: #c2543f;
  color: #8f4531;
}

.hint {
  flex-shrink: 0;
  text-align: center;
  font-size: 10px;
  color: #7d9cb0;
}

.result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 18px;
}

.result-title {
  font-size: 18px;
  font-weight: 700;
  color: #14547b;
}

.result-score {
  font:
    900 44px Menlo,
    monospace;
  color: #1c7fb4;
  line-height: 1.1;
}

.result-lbl {
  font-size: 11px;
  color: #7d9cb0;
}

.result-rank {
  margin-top: 6px;
  font-size: 12px;
  font-weight: 600;
  color: #1c7fb4;
  background: #eaf7ff;
  border-radius: 20px;
  padding: 4px 13px;
}

.review {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  padding: 10px 12px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 14px;
}

.review-title {
  font-size: 10px;
  font-weight: 700;
  color: #1c7fb4;
  margin-bottom: 4px;
}

.review-item {
  display: flex;
  gap: 6px;
  padding: 3px 0;
  border-top: 1px dashed #e2eff7;
}

.mark {
  flex: none;
  font-size: 11px;
}

.review-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.review-q {
  font-size: 10.5px;
  color: #2b5f7d;
  line-height: 1.4;
}

.review-a {
  font-size: 10px;
  color: #7d9cb0;
}

@media (max-height: 660px) {
  .q-text {
    font-size: 14px;
  }
  .option {
    padding: 8px 10px;
    font-size: 12px;
  }
  .result-score {
    font-size: 36px;
  }
  .review-q {
    font-size: 10px;
  }
}
