/* 认证配对：左边三个市场，下边三张认证卡。 */
.npc {
  flex-shrink: 0;
  display: flex;
  gap: 10px;
  align-items: center;
  padding: 9px 11px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 14px;
}

.npc-head {
  flex: none;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: #e6f5ff;
  color: #278fc5;
  font-size: 17px;
  font-weight: 600;
  text-align: center;
  line-height: 38px;
}

.npc-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.npc-name {
  font-size: 11px;
  font-weight: 600;
  color: #1e7fb0;
}

.npc-text {
  font-size: 11px;
  line-height: 1.45;
  color: #3d6a83;
}

.markets {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
  justify-content: center;
}

.markets.shake {
  animation: shake 0.3s ease-in-out;
}

.market {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 12px;
  background: #fff;
  border: 1.5px dashed #a9d7ef;
  border-radius: 14px;
}

.market.sel {
  border-style: solid;
  border-color: #249fdb;
  background: #f1faff;
  box-shadow: 0 0 0 3px #249fdb22;
}

.market.done {
  border-style: solid;
  border-color: #1a8f5f;
  background: #f0faf5;
}

.market-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.market-name {
  font-size: 14px;
  font-weight: 650;
  color: #15527a;
}

.market-hint {
  font-size: 10px;
  color: #7d9cb0;
}

.market-cert {
  flex: none;
  font-size: 12px;
  font-weight: 600;
  color: #1c7fb4;
  background: #eaf7ff;
  border-radius: 8px;
  padding: 4px 9px;
}

.market.done .market-cert {
  color: #146b48;
  background: #e2f6ec;
}

.certs {
  flex-shrink: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
}

.cert {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 10px 8px;
  background: linear-gradient(150deg, #ffffff, #eef8ff);
  border: 1.5px solid #6cbfe8;
  border-radius: 12px;
  text-align: center;
}

.cert.used {
  border-color: #cfe3ee;
  background: #f5fafd;
  opacity: 0.55;
}

.cert-name {
  font:
    700 12px Menlo,
    monospace;
  color: #14608d;
}

.cert-note {
  font-size: 9.5px;
  color: #7d9cb0;
  line-height: 1.3;
}

.feedback {
  flex-shrink: 0;
  font-size: 11px;
  line-height: 1.5;
  padding: 8px 10px;
  border-radius: 10px;
  background: #fdeeea;
  border-left: 3px solid #c2543f;
  color: #8f4531;
}

.hint {
  flex-shrink: 0;
  text-align: center;
  font-size: 10px;
  color: #7d9cb0;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: #0e3a5733;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22px;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 20px;
  padding: 20px 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  animation: pop-up 0.28s ease-out;
}

.win-title {
  font-size: 19px;
  font-weight: 700;
  color: #146b48;
  text-align: center;
}

.win-text {
  font-size: 13px;
  line-height: 1.6;
  color: #2b5f7d;
}

.win-value {
  align-self: center;
  font-size: 12px;
  font-weight: 600;
  color: #1c7fb4;
  background: #eaf7ff;
  border-radius: 20px;
  padding: 5px 14px;
}

@keyframes shake {
  0%,
  100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-6px);
  }
  75% {
    transform: translateX(6px);
  }
}

@keyframes pop-up {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-height: 640px) {
  .market {
    padding: 7px 10px;
  }
  .market-name {
    font-size: 13px;
  }
  .cert {
    padding: 8px 6px;
  }
  .npc {
    padding: 7px 9px;
  }
}
