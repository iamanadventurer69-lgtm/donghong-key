<view class="viewport">
  <view class="topline">
    <text class="eyebrow">ENERGY CRUSH / 能量三消</text>
    <button class="text-button" bindtap="back">返回闯关</button>
  </view>
  <view class="hud">
    <view class="hud-item"><text class="hud-val">{{timeLeft}}</text><text class="hud-lbl">剩余时间</text></view>
    <view class="hud-item"><text class="hud-val">{{score}}</text><text class="hud-lbl">得分</text></view>
    <view class="hud-item"><text class="hud-val">{{combo}}</text><text class="hud-lbl">连击</text></view>
  </view>
  <view class="board {{shake?'shake':''}}">
    <view wx:for="{{board}}" wx:for-item="row" wx:key="key" class="row">
      <view
        wx:for="{{row.cells}}"
        wx:for-item="cell"
        wx:key="key"
        class="cell {{selected && selected.row===cell.row && selected.col===cell.col?'sel':''}} {{cell.clearing?'pop':''}}"
        style="background:{{cell.color}}"
        data-row="{{cell.row}}"
        data-col="{{cell.col}}"
        bindtap="tap"
      >{{cell.emoji}}</view>
    </view>
  </view>
  <view class="hint">{{hint}} · 三连 10 分，连击翻倍</view>
  <button class="secondary" bindtap="restart">🔄 重新开始</button>
  <view class="mask" wx:if="{{over}}">
    <view class="sheet">
      <view class="win-title">🎉 时间到！</view>
      <view class="win-score">{{score}}</view>
      <view class="win-lbl">最终得分</view>
      <view class="win-rank">{{score>=300?'⭐ 手速大师':score>=150?'👍 手速不错':'💪 再接再厉'}}</view>
      <button class="primary" bindtap="back">回到闯关中心 →</button>
      <button class="secondary" bindtap="restart">🔄 再来一局</button>
    </view>
  </view>
</view>
