/* 文化跳格子：一条 3×4 的格子路 + 当前格子的知识点与题目。 */
.hud {
  flex-shrink: 0;
  display: flex;
  justify-content: space-around;
  padding: 7px 10px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 14px;
}

.hud-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hud-val {
  font:
    700 17px Menlo,
    monospace;
  color: #1c7fb4;
  line-height: 1.15;
}

.hud-sub {
  font-size: 10px;
  color: #7d9cb0;
}

.hud-lbl {
  font-size: 10px;
  color: #6a8ea4;
}

.stones {
  flex-shrink: 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
}

.stone {
  position: relative;
  min-height: 46px;
  border-radius: 12px;
  padding: 5px 4px 6px;
  background: #f2f9ff;
  border: 1.5px solid #d3e8f6;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1px;
}

.stone.passed {
  background: #e6f5ff;
  border-color: #7cc4e8;
}

.stone.here {
  border-color: #249fdb;
  background: #ffffff;
  box-shadow: 0 0 0 3px #249fdb22;
}

.stone.goal {
  background: linear-gradient(150deg, #eaf9f2, #d8f2e6);
  border-color: #57b99a;
}

.stone-label {
  font:
    700 11px Menlo,
    monospace;
  color: #1c7fb4;
}

.stone-name {
  font-size: 9px;
  line-height: 1.2;
  color: #6a8ea4;
  text-align: center;
}

.hopper {
  position: absolute;
  bottom: -8px;
  font-size: 15px;
  animation: hop-in 0.42s cubic-bezier(0.2, 0.9, 0.3, 1.4);
}

.panel {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 11px 13px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 16px;
  overflow: hidden;
}

.tile-head {
  display: flex;
  align-items: baseline;
  gap: 7px;
}

.tile-index {
  font:
    700 11px Menlo,
    monospace;
  color: #1c7fb4;
}

.tile-name {
  font-size: 14px;
  font-weight: 650;
  color: #15527a;
}

.tile-point {
  font-size: 11.5px;
  line-height: 1.5;
  color: #2b5f7d;
  background: #f3faff;
  border-left: 3px solid #7cc4e8;
  border-radius: 0 8px 8px 0;
  padding: 6px 9px;
}

.q-text {
  font-size: 13.5px;
  font-weight: 600;
  line-height: 1.5;
  color: #123f60;
}

.q-opts {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
}

.option {
  width: 100%;
  text-align: left;
  padding: 8px 11px;
  background: #f4faff;
  border: 1px solid #bfdef2;
  border-radius: 11px;
  color: #235b7a;
  font-size: 12.5px;
  line-height: 1.4;
}

.option.right {
  background: #e8f8f1;
  border-color: #1a8f5f;
  color: #146b48;
}

.option.wrong {
  background: #fdeeea;
  border-color: #c2543f;
  color: #a4452f;
}

.feedback {
  font-size: 10.5px;
  line-height: 1.5;
  padding: 7px 9px;
  border-radius: 10px;
  border-left: 3px solid;
}

.feedback.good {
  background: #eaf9f2;
  border-color: #1a8f5f;
  color: #206a4c;
}

.feedback.bad {
  background: #fdeeea;
  border-color: #c2543f;
  color: #8f4531;
}

.hint {
  text-align: center;
  font-size: 10px;
  color: #7d9cb0;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: #0e3a5733;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22px;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 20px;
  padding: 20px 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  animation: pop-up 0.28s ease-out;
}

.win-title {
  font-size: 19px;
  font-weight: 700;
  color: #146b48;
  text-align: center;
}

.win-text {
  font-size: 13px;
  line-height: 1.6;
  color: #2b5f7d;
}

.win-stats,
.win-rank {
  align-self: center;
  font-size: 12px;
  font-weight: 600;
  color: #1c7fb4;
  background: #eaf7ff;
  border-radius: 20px;
  padding: 5px 14px;
}

@keyframes hop-in {
  from {
    transform: translateY(-14px) scale(0.7);
    opacity: 0;
  }
  to {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

@keyframes pop-up {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-height: 660px) {
  .stone {
    min-height: 38px;
  }
  .stone-name {
    display: none;
  }
  .tile-point {
    font-size: 11px;
  }
  .q-text {
    font-size: 12.5px;
  }
  .option {
    padding: 6px 9px;
    font-size: 12px;
  }
}
