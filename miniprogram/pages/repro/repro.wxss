/* 复现异常：说明 + 状态条 + 实时实验台（组件自带滑杆与波形）。 */
.npc {
  flex-shrink: 0;
  display: flex;
  gap: 10px;
  align-items: center;
  padding: 9px 11px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 14px;
}

.npc-head {
  flex: none;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: #e6f5ff;
  color: #278fc5;
  font-size: 17px;
  font-weight: 600;
  text-align: center;
  line-height: 38px;
}

.npc-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.npc-name {
  font-size: 11px;
  font-weight: 600;
  color: #1e7fb0;
}

.npc-text {
  font-size: 11px;
  line-height: 1.45;
  color: #3d6a83;
}

.hud {
  flex-shrink: 0;
  display: flex;
  justify-content: space-around;
  padding: 8px 10px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 14px;
}

.hud-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hud-val {
  font:
    700 17px Menlo,
    monospace;
  color: #1c7fb4;
  line-height: 1.15;
}

.hud-sub {
  font-size: 10px;
  color: #7d9cb0;
}

.hud-lbl {
  font-size: 10px;
  color: #6a8ea4;
}

.meter {
  flex: 1;
  min-height: 190px;
  max-height: 320px;
  padding: 8px 10px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 16px;
}

.feedback {
  flex-shrink: 0;
  font-size: 11px;
  line-height: 1.5;
  padding: 8px 10px;
  border-radius: 10px;
  background: #eef7fd;
  border-left: 3px solid #6cbfe8;
  color: #2b5f7d;
}

.feedback.good {
  background: #eaf9f2;
  border-color: #1a8f5f;
  color: #206a4c;
}

.hint {
  flex-shrink: 0;
  text-align: center;
  font-size: 10px;
  color: #7d9cb0;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: #0e3a5733;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22px;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 20px;
  padding: 20px 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  animation: pop-up 0.28s ease-out;
}

.win-title {
  font-size: 19px;
  font-weight: 700;
  color: #146b48;
  text-align: center;
}

.win-text {
  font-size: 13px;
  line-height: 1.6;
  color: #2b5f7d;
}

.win-value {
  align-self: center;
  font-size: 12px;
  font-weight: 600;
  color: #1c7fb4;
  background: #eaf7ff;
  border-radius: 20px;
  padding: 5px 14px;
}

@keyframes pop-up {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-height: 640px) {
  .meter {
    min-height: 160px;
  }
  .npc {
    padding: 7px 9px;
  }
  .hud {
    padding: 6px 8px;
  }
}
