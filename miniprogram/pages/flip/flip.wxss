/* 模块配对：4×4 翻牌，3D 翻转用 transform + backface-visibility。 */
.hud {
  flex-shrink: 0;
  display: flex;
  justify-content: space-around;
  padding: 8px 10px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 14px;
}

.hud-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hud-val {
  font:
    700 19px Menlo,
    monospace;
  color: #1c7fb4;
  line-height: 1.1;
}

.hud-sub {
  font-size: 12px;
  color: #7d9cb0;
}

.hud-lbl {
  font-size: 10px;
  color: #6a8ea4;
}

.grid {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(4, 1fr);
  gap: 8px;
}

.card {
  min-height: 0;
  perspective: 800px;
}

.inner {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1);
}

.card.flipped .inner {
  transform: rotateY(180deg);
}

.card.matched .inner {
  animation: match-glow 0.6s ease;
}

.face {
  position: absolute;
  inset: 0;
  backface-visibility: hidden;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4px;
  text-align: center;
  border: 1.5px solid #b9def2;
}

.front {
  background: linear-gradient(150deg, #ffffff, #e3f4ff);
}

.logo {
  font:
    800 15px Menlo,
    monospace;
  letter-spacing: 2px;
  color: #a9d8f2;
}

.qmark {
  font-size: 18px;
  color: #7cc4e8;
}

.back {
  transform: rotateY(180deg);
  background: linear-gradient(150deg, #ffffff, #f2fbff);
  border-color: #6cbfe8;
}

.emoji {
  font-size: 20px;
  margin-bottom: 2px;
}

.label {
  font-size: 10px;
  font-weight: 600;
  line-height: 1.25;
  color: #1f5372;
}

.card.matched .back {
  background: #e8f8f1;
  border-color: #1a8f5f;
}

.hint {
  flex-shrink: 0;
  text-align: center;
  font-size: 10px;
  color: #7d9cb0;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: #0e3a5733;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22px;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 20px;
  padding: 20px 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  animation: pop-up 0.28s ease-out;
}

.win-title {
  font-size: 21px;
  font-weight: 700;
  color: #14547b;
  text-align: center;
}

.win-text {
  font-size: 13px;
  color: #3d6a83;
  text-align: center;
}

.win-rank {
  align-self: center;
  font-size: 13px;
  font-weight: 600;
  color: #1c7fb4;
  background: #eaf7ff;
  border-radius: 20px;
  padding: 5px 14px;
}

@keyframes match-glow {
  50% {
    box-shadow: 0 0 18px #48b8ea88;
  }
}

@keyframes pop-up {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-height: 640px) {
  .card .label {
    font-size: 9px;
  }
  .emoji {
    font-size: 17px;
  }
  .grid {
    gap: 6px;
  }
}
