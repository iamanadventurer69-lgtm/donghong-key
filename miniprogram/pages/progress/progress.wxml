<view class="viewport" bindtouchstart="swipeStart" bindtouchend="swipeEnd" bindtouchcancel="swipeCancel"><view class="topline"><text class="eyebrow">EXPLORER ARCHIVE / 探索档案</text></view><view wx:if="{{warning}}" class="save-warning">{{warning}}</view>
<view class="panel" wx:if="{{panel===0}}"><view class="title">每一步，都留下印记。</view><view class="card"><view class="row"><text>第一阶段</text><text class="number">{{percent}}%</text></view><view class="progress-track"><view class="progress-fill" style="width:{{percent}}%"/></view><view class="small muted">最近保存：{{updated}}</view></view><view class="card"><view wx:for="{{stages}}" wx:key="name" class="stage"><text class="success">{{item.done?'✓':'○'}}</text><text>{{item.name}}</text><text class="small muted">{{item.done?'已点亮':'待探索'}}</text></view></view><button class="primary" bindtap="resume">{{s.completed?'回顾文化印记':'继续上次探索 →'}}</button></view>
<view class="panel" wx:elif="{{panel===1}}"><view class="title">东鸿文化坐标</view><view class="card"><view class="label">愿景</view><view class="quote">{{culture.vision}}</view><view class="line"/><view class="label">使命</view><view class="quote">{{culture.mission}}</view><view class="line"/><view class="label">理念</view><view class="quote">{{culture.belief}}</view></view><view class="card"><view class="label">发展导向</view><view wx:for="{{culture.directions}}" wx:key="*this" class="direction">{{item}}</view></view></view>
<view class="panel" wx:elif="{{panel===2}}"><view class="title">价值观，是行动。</view><view class="card" wx:for="{{culture.values}}" wx:key="name"><view class="tag">{{item.name}}</view><view class="muted">{{item.text}}</view></view></view>
<view class="panel" wx:else><view class="title">我的行动与存档</view><view class="culture"><view class="label">我的行动承诺</view><view class="quote">{{s.pledge||'完成第一章后，记录你的行动承诺。'}}</view></view><view class="card">进度仅保存在当前设备。清除缓存、更换设备或重新安装后无法恢复。<view class="line"/><view class="muted">本原型不采集员工身份信息。</view></view><button wx:if="{{warning}}" class="secondary" bindtap="retry">重试保存</button><button class="secondary" bindtap="reset">清除本机存档，重新探索</button><button class="primary" bindtap="home">返回首页</button></view>
<view class="pager"><button class="nav-arrow" bindtap="prevPanel" disabled="{{panel===0}}">‹</button><view class="pager-center"><view class="dots"><text wx:for="{{panelCount}}" wx:key="*this" class="dot {{index===panel?'active':''}}"/></view><text>左右滑动翻页 · {{panel+1}} / {{panelCount}}</text></view><button class="nav-arrow" bindtap="nextPanel" disabled="{{panel===panelCount-1}}">›</button></view></view>
