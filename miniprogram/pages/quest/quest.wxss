/* 闯关中心：任务轨道 + 打卡弹层 + 通关结算弹层。 */
.hud {
  flex-shrink: 0;
  padding: 9px 12px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 14px;
}

.hud-num {
  font:
    600 16px Menlo,
    monospace;
  color: #1c7fb4;
}

.track {
  height: 6px;
  background: #e2f0f8;
  border-radius: 6px;
  overflow: hidden;
  margin: 6px 0 5px;
}

.track-fill {
  height: 100%;
  background: linear-gradient(90deg, #4bc0f0, #249fdb);
  transition: width 0.4s ease;
}

.rail {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  align-content: start;
}

.task {
  display: flex;
  flex-direction: column;
  gap: 1px;
  padding: 7px 9px;
  background: #fff;
  border: 1px solid #d7ecf8;
  border-radius: 12px;
  text-align: left;
  min-height: 0;
}

.task.done {
  background: #eff9ff;
  border-color: #8fd0f0;
}

.task-icon {
  font-size: 15px;
  line-height: 1.1;
}

.task-name {
  font-size: 12px;
  font-weight: 600;
  line-height: 1.25;
  color: #1b5172;
}

.task.done .task-name {
  color: #2b8bb8;
}

.task-foot {
  display: flex;
  align-items: center;
  gap: 3px;
  font-size: 10px;
  color: #85a4b6;
}

.task-score {
  font:
    600 10px Menlo,
    monospace;
  color: #1c7fb4;
}

.task-state {
  margin-left: auto;
  font-size: 13px;
  color: #4f9dc6;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: #0e3a5733;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
}

.sheet {
  width: 100%;
  max-height: 100%;
  overflow: hidden;
  background: #fff;
  border-radius: 20px;
  padding: 18px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  animation: pop-up 0.28s ease-out;
}

.badge {
  align-self: flex-start;
  font-size: 10px;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #3db5ea, #1f8fc8);
  border-radius: 20px;
  padding: 4px 12px;
}

.sheet-title {
  font-size: 18px;
  font-weight: 650;
  color: #123f60;
}

.sheet-q {
  font-size: 13px;
  line-height: 1.6;
  color: #2b5f7d;
}

.option {
  display: flex;
  align-items: center;
  gap: 9px;
  width: 100%;
  text-align: left;
  padding: 10px 12px;
  background: #f4faff;
  border: 1px solid #bfdef2;
  border-radius: 12px;
  color: #235b7a;
  font-size: 13px;
  line-height: 1.45;
}

.option.right {
  background: #e8f8f1;
  border-color: #1a8f5f;
  color: #146b48;
}

.option.wrong {
  background: #fdeeea;
  border-color: #c2543f;
  color: #a4452f;
}

.letter {
  flex: none;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #e4f4fe;
  color: #1c7fb4;
  font-size: 11px;
  font-weight: 700;
  text-align: center;
  line-height: 20px;
}

.explain {
  font-size: 11px;
  line-height: 1.6;
  padding: 8px 10px;
  border-radius: 10px;
  border-left: 3px solid;
}

.explain.ok {
  background: #eaf9f2;
  border-color: #1a8f5f;
  color: #206a4c;
}

.explain.no {
  background: #fdeeea;
  border-color: #c2543f;
  color: #8f4531;
}

.final {
  gap: 4px;
  padding: 14px;
  overflow: auto;
}

.final-title {
  font-size: 18px;
  font-weight: 700;
  color: #14547b;
  text-align: center;
}

.final-tasks {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3px;
}

.final-task {
  display: flex;
  justify-content: space-between;
  gap: 6px;
  font-size: 10px;
  color: #2b5f7d;
  background: #f3faff;
  border-radius: 8px;
  padding: 2px 7px;
}

.final-scores {
  display: flex;
  justify-content: space-between;
  gap: 6px;
}

.final-score {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f3faff;
  border-radius: 10px;
  padding: 4px 2px;
}

.final-val {
  font:
    700 16px Menlo,
    monospace;
  color: #1c7fb4;
}

.final-lbl {
  font-size: 9px;
  color: #7d9cb0;
}

.final-detail {
  background: #f7fcff;
  border: 1px dashed #cfe7f5;
  border-radius: 12px;
  padding: 8px 10px;
}

.detail-title {
  font-size: 11px;
  font-weight: 600;
  color: #1c7fb4;
  margin-bottom: 4px;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: #3d6a83;
  padding: 1px 0;
}

.grade {
  align-self: center;
  padding: 7px 26px;
  border-radius: 30px;
  color: #fff;
  font:
    900 17px Menlo,
    monospace;
  letter-spacing: 2px;
}

.final-msg {
  text-align: center;
  line-height: 1.55;
  font-size: 11px;
}

@keyframes pop-up {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-height: 660px) {
  .final-detail {
    display: none;
  }
}

@media (max-height: 640px) {
  .task {
    padding: 6px 10px;
    margin-bottom: 4px;
  }
  .task-name {
    font-size: 12px;
  }
  .sheet-title {
    font-size: 16px;
  }
  .option {
    padding: 8px 10px;
  }
  .final-task {
    font-size: 10px;
  }
}
