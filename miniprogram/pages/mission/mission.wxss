.mission-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 14px 18px calc(18px + env(safe-area-inset-bottom));
  background: #f3fbff;
  color: #174e6d;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.mission-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.eyebrow {
  font-size: 10px;
  color: #2c91c8;
  letter-spacing: 1.4px;
  font-weight: 600;
}
.mission-top button {
  background: #fff;
  border: 1px solid #b8e0f3;
  color: #33799e;
  border-radius: 10px;
  font-size: 12px;
  padding: 7px 12px;
}
.mission-top button::after,
.primary::after,
.answer::after {
  border: 0;
}
.scene {
  height: 208px;
  border-radius: 24px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 10px 24px #4b97bd28;
}
.scene-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(#fff7 1px, transparent 1px), linear-gradient(90deg, #fff7 1px, transparent 1px);
  background-size: 22px 22px;
}
.scene-title {
  position: absolute;
  left: 22px;
  top: 22px;
  color: #fff;
  font-size: 31px;
  font-weight: 700;
  text-shadow: 0 2px 8px #15597855;
}
.scene-direction {
  position: absolute;
  left: 24px;
  top: 70px;
  color: #effaff;
  font-size: 13px;
}
.npc {
  position: absolute;
  right: 25px;
  bottom: 22px;
  text-align: center;
  color: #175779;
  font-size: 12px;
  font-weight: 600;
}
.npc-head {
  height: 66px;
  width: 66px;
  background: #fff;
  border: 4px solid #d8f3ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #278fc5;
  font-size: 28px;
  margin: auto auto 7px;
  animation: float 2.2s ease-in-out infinite;
}
.dialog {
  background: #fff;
  border: 1px solid #c5e7f7;
  border-radius: 20px;
  padding: 20px;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 17px;
}
.dialog-role {
  font-size: 13px;
  color: #2e84b0;
}
.dialog-text,
.question {
  font-size: 19px;
  font-weight: 600;
  line-height: 1.65;
}
.primary {
  height: 47px;
  width: 100%;
  background: #249fdb;
  color: #fff;
  border-radius: 14px;
  font-size: 15px;
  font-weight: 600;
}
.answer {
  width: 100%;
  text-align: left;
  background: #ecf8ff;
  border: 1px solid #bae2f5;
  color: #235b7a;
  border-radius: 13px;
  padding: 14px;
  font-size: 15px;
}
.feedback {
  background: #e2f5ff;
  color: #2a6c8f;
  padding: 12px;
  border-radius: 10px;
  font-size: 13px;
  line-height: 1.55;
}
.badge {
  height: 70px;
  width: 70px;
  border-radius: 50%;
  background: #58b997;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36px;
  margin: auto;
}
.culture {
  border-left: 4px solid #52afd9;
  background: #e7f6ff;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 12px;
  color: #377da2;
}
.culture strong {
  font-size: 18px;
  color: #1e658c;
}
@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8px);
  }
}
@media (max-height: 600px) {
  .scene {
    height: 158px;
  }
  .dialog {
    padding: 15px;
    gap: 11px;
  }
  .dialog-text,
  .question {
    font-size: 16px;
  }
  .mission-page {
    gap: 10px;
    padding-top: 8px;
  }
}
