/* 企业文化模块：进度条 + 打卡卡 + 互动关卡 + 小游戏入口 + 弹层。 */
.hud {
  flex-shrink: 0;
  padding: 8px 12px;
  background: #fff;
  border: 1px solid #cce7f7;
  border-radius: 14px;
}

.hud-num {
  font:
    600 15px Menlo,
    monospace;
  color: #1c7fb4;
}

.track {
  height: 6px;
  background: #e2f0f8;
  border-radius: 6px;
  overflow: hidden;
  margin: 5px 0 4px;
}

.track-fill {
  height: 100%;
  background: linear-gradient(90deg, #4bc0f0, #249fdb);
  transition: width 0.4s ease;
}

.section-title {
  flex-shrink: 0;
  font-size: 11px;
  font-weight: 700;
  color: #1c7fb4;
  margin-top: 2px;
}

.quest-grid {
  flex-shrink: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}

.tile {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 7px 9px;
  background: #fff;
  border: 1px solid #d7ecf8;
  border-radius: 12px;
  text-align: left;
}

.tile.done {
  background: #eff9ff;
  border-color: #8fd0f0;
}

.tile-icon {
  flex: none;
  font-size: 16px;
}

.tile-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.tile-name {
  font-size: 12.5px;
  font-weight: 650;
  color: #15527a;
}

.tile.done .tile-name {
  color: #2b8bb8;
}

.tile-hint {
  font-size: 9.5px;
  color: #85a4b6;
}

.tile-state {
  flex: none;
  font-size: 10px;
  color: #4f9dc6;
}

.gate-grid {
  flex-shrink: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
}

.gate {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1px;
  padding: 9px 6px;
  background: #fff;
  border: 1px solid #d7ecf8;
  border-radius: 12px;
}

.gate.done {
  background: #eff9ff;
  border-color: #8fd0f0;
}

.gate-icon {
  font-size: 18px;
}

.gate-name {
  font-size: 12px;
  font-weight: 650;
  color: #15527a;
}

.gate.done .gate-name {
  color: #2b8bb8;
}

.gate-hint {
  font-size: 9px;
  color: #85a4b6;
}

.gate-state {
  position: absolute;
  top: 6px;
  right: 8px;
  font-size: 11px;
  color: #4f9dc6;
}

.entry {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: linear-gradient(140deg, #ffffff, #eaf6ff);
  border: 1.5px solid #6cbfe8;
  border-radius: 14px;
  text-align: left;
}

.entry.locked {
  background: #f7fbfe;
  border-style: dashed;
  border-color: #cfe3ee;
}

.entry-icon {
  flex: none;
  font-size: 20px;
}

.entry-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.entry-name {
  font-size: 13px;
  font-weight: 650;
  color: #14608d;
}

.entry.locked .entry-name {
  color: #7d9cb0;
  font-weight: 600;
}

.entry-hint {
  font-size: 10px;
  color: #85a4b6;
}

.entry-state {
  flex: none;
  font-size: 15px;
  color: #4f9dc6;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: #0e3a5733;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
}

.sheet {
  width: 100%;
  max-height: 100%;
  overflow: hidden;
  background: #fff;
  border-radius: 20px;
  padding: 16px 15px;
  display: flex;
  flex-direction: column;
  gap: 7px;
  animation: pop-up 0.28s ease-out;
}

.badge {
  align-self: flex-start;
  font-size: 10px;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #3db5ea, #1f8fc8);
  border-radius: 20px;
  padding: 4px 12px;
}

.sheet-title {
  font-size: 17px;
  font-weight: 650;
  color: #123f60;
}

.intro {
  font-size: 11px;
  line-height: 1.5;
  color: #2b5f7d;
  background: #f3faff;
  border-left: 3px solid #7cc4e8;
  border-radius: 0 8px 8px 0;
  padding: 7px 9px;
  white-space: pre-line;
}

.sheet-q {
  font-size: 12.5px;
  font-weight: 600;
  line-height: 1.55;
  color: #1b5172;
}

.option {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  text-align: left;
  padding: 8px 10px;
  background: #f4faff;
  border: 1px solid #bfdef2;
  border-radius: 11px;
  color: #235b7a;
  font-size: 12px;
  line-height: 1.4;
}

.option.right {
  background: #e8f8f1;
  border-color: #1a8f5f;
  color: #146b48;
}

.option.wrong {
  background: #fdeeea;
  border-color: #c2543f;
  color: #a4452f;
}

.letter {
  flex: none;
  width: 19px;
  height: 19px;
  border-radius: 50%;
  background: #e4f4fe;
  color: #1c7fb4;
  font-size: 10px;
  font-weight: 700;
  text-align: center;
  line-height: 19px;
}

.explain {
  font-size: 10.5px;
  line-height: 1.55;
  padding: 7px 9px;
  border-radius: 10px;
  border-left: 3px solid;
}

.explain.ok {
  background: #eaf9f2;
  border-color: #1a8f5f;
  color: #206a4c;
}

.explain.no {
  background: #fdeeea;
  border-color: #c2543f;
  color: #8f4531;
}

.final {
  gap: 4px;
  padding: 14px;
  overflow: auto;
}

.final-title {
  font-size: 18px;
  font-weight: 700;
  color: #14547b;
  text-align: center;
}

.final-tasks {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3px;
}

.final-task {
  display: flex;
  justify-content: space-between;
  gap: 6px;
  font-size: 10px;
  color: #2b5f7d;
  background: #f3faff;
  border-radius: 8px;
  padding: 2px 7px;
}

.final-scores {
  display: flex;
  justify-content: space-between;
  gap: 6px;
}

.final-score {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f3faff;
  border-radius: 10px;
  padding: 4px 2px;
}

.final-val {
  font:
    700 15px Menlo,
    monospace;
  color: #1c7fb4;
}

.final-lbl {
  font-size: 9px;
  color: #7d9cb0;
}

.final-detail {
  background: #f7fcff;
  border: 1px dashed #cfe7f5;
  border-radius: 12px;
  padding: 7px 9px;
}

.detail-title {
  font-size: 11px;
  font-weight: 600;
  color: #1c7fb4;
  margin-bottom: 3px;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  font-size: 10.5px;
  color: #3d6a83;
  padding: 1px 0;
}

.grade {
  align-self: center;
  padding: 5px 22px;
  border-radius: 30px;
  color: #fff;
  font:
    900 15px Menlo,
    monospace;
  letter-spacing: 2px;
}

.final-msg {
  text-align: center;
  line-height: 1.55;
  font-size: 11px;
}

@keyframes pop-up {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-height: 660px) {
  .final-detail {
    display: none;
  }
}

@media (max-height: 640px) {
  .tile {
    padding: 6px 8px;
  }
  .tile-name {
    font-size: 12px;
  }
  .gate {
    padding: 7px 5px;
  }
  .sheet-title {
    font-size: 16px;
  }
  .option {
    padding: 7px 9px;
  }
}
