:host{display:block;height:100%}.instrument{box-sizing:border-box;background:#fff;border:1px solid #aedcf3;border-radius:18px;padding:12px;height:100%;color:#266286;display:flex;flex-direction:column;gap:5px}.header{display:flex;align-items:center;justify-content:space-between;font-size:12px;flex-shrink:0}.status{color:#288fc2;font-size:11px}.readout{display:flex;align-items:baseline;flex-shrink:0}.digits{font:28px Menlo,monospace;letter-spacing:2px;color:#268fc9}.mode{margin-left:auto;font-size:10px;color:#5c88a3}.wave{width:100%;flex:1;height:45px;min-height:25px}.caption{font-size:11px;color:#467d9e;flex-shrink:0}.note{font-size:9px;color:#66869d;flex-shrink:0}.header button{background:#33a8de;color:#fff;font-size:12px;margin:0;padding:2px 18px;border-radius:9px;line-height:28px}.header button::after{border:none}slider{margin:2px 0;flex-shrink:0}@media(max-height:600px){.instrument{padding:8px;gap:3px}.digits{font-size:24px}.note{font-size:8px}.header button{line-height:24px}.caption{font-size:10px}}
